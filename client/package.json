{
    "name": "pgowp",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "start": "concurrently \"npm run start:client\" \"npm run start:worker\"",
        "start:client": "npm run dev",
        "start:worker": "npx wrangler dev -c wrangler.dev.toml --ip 127.0.0.1 --port 8787",
        "dev": "vite --host",
        "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "test": "vitest",
        "db:migrate:local": "npx wrangler d1 migrations apply pgowp-bookings --local -c wrangler.dev.toml"
    },
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hot-toast": "^2.4.1",
        "react-icons": "^4.12.0",
        "react-router-dom": "^6.3.0",
        "resend": "^4.0.1-alpha.0",
        "stripe": "^17.4.0"
    },
    "devDependencies": {
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react-swc": "^3.7.1",
        "autoprefixer": "^10.4.7",
        "postcss": "^8.4.14",
        "sass": "^1.57.1",
        "tailwindcss": "^3.3.2",
        "typescript": "^5.5.4",
        "vite": "^5.4.10",
        "vite-plugin-svgr": "^4.3.0",
        "vitest": "^2.1.9"
    },
    "overrides": {
        "@types/node": "20.8.3"
    },
    "private": true,
    "author": "Nathanuel Dixon"
}
